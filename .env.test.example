# Test database isolation
#
# Vitest loads .env.test FIRST (before .env.local). Copy this file to
# .env.test and point it at a database that is safe to wipe. Tests insert
# fixture rows (users 00000000-0000-0000-0000-...) and delete them on
# teardown; if the URL points at a shared production Supabase pooler the
# config will refuse to run.
#
# Two recommended setups:
#
# 1) Local Docker postgres (preferred):
#      docker run -d --name bingx-test-db -p 54329:5432 \
#        -e POSTGRES_PASSWORD=test -e POSTGRES_DB=bingx_test postgres:16
#      Then point both URLs at it:
TEST_DATABASE_URL=postgresql://postgres:test@127.0.0.1:54329/bingx_test
TEST_DIRECT_URL=postgresql://postgres:test@127.0.0.1:54329/bingx_test

#
# 2) Dedicated Supabase test project / branch (good for CI):
# TEST_DATABASE_URL=postgresql://postgres.<test_project_ref>:<pwd>@aws-...-pooler.supabase.com:6543/postgres
# TEST_DIRECT_URL=postgresql://postgres:<pwd>@db.<test_project_ref>.supabase.co:5432/postgres
#
# Escape hatch (only if you accept tests run against a shared / prod DB):
# TEST_DATABASE_ALLOW_PROD=1
